# Copy to backend.hcl and fill in your project id, then:
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored because the bucket name embeds the project id, and
# this repository is public. The up and down scripts derive the same values
# from `gcloud config get-value project`, so they need no file.
#
# Find the bucket name with:
#   gcloud storage buckets list --format='value(name)' | Select-String tfstate
#
# Unlike the S3 backend there is no `key`, `region`, `encrypt` or
# `use_lockfile`: GCS uses a path prefix, infers the location from the bucket,
# always encrypts at rest, and locks natively.

bucket = "web-store-tfstate-REPLACE_WITH_PROJECT_ID"
prefix = "persistent"
