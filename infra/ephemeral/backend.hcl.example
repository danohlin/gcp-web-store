# Copy to backend.hcl and fill in your project id, then:
#   terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored because the bucket name embeds the project id, and
# this repository is public. The up and down scripts derive the same values
# from `gcloud config get-value project`, so they need no file.
#
# The bucket is created by the persistent stack; take the name from its
# `state_bucket` output, or from its `backend_config` output which produces
# exactly these two values.

bucket = "web-store-tfstate-REPLACE_WITH_PROJECT_ID"
prefix = "ephemeral"
