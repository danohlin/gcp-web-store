#!/bin/sh
# Blocks credentials, private keys and cloud account identifiers from being
# committed. Enabled by `git config core.hooksPath .githooks` (see
# scripts/install-hooks.ps1).
#
# Deliberately dependency-free so it always runs. If gitleaks happens to be on
# PATH it runs too, as a second opinion.
#
# To bypass for a genuine false positive, append the marker
#   pragma: allowlist secret
# to the offending line, or as a last resort commit with --no-verify.

set -eu

RED=''
YELLOW=''
RESET=''
if [ -t 1 ]; then
  RED=$(printf '\033[31m'); YELLOW=$(printf '\033[33m'); RESET=$(printf '\033[0m')
fi

fail=0

note() { printf '%s%s%s\n' "$RED" "$1" "$RESET" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

# --------------------------------------------------------------------------
# 1. Paths that must never be committed
# --------------------------------------------------------------------------
for f in $staged; do
  case "$f" in
    *.example|*.sample|*.md) continue ;;
  esac

  case "$f" in
    .env|.env.*|*/.env|*/.env.*)
      note "BLOCKED  $f  — environment files hold real credentials"; fail=1 ;;
    *.tfvars|*.tfvars.json|*.auto.tfvars)
      note "BLOCKED  $f  — tfvars routinely contain account ids and secrets"; fail=1 ;;
    *.tfstate|*.tfstate.*)
      note "BLOCKED  $f  — Terraform state stores secrets in plaintext"; fail=1 ;;
    *.pem|*.key|*.p12|*.pfx|*id_rsa*|*id_ed25519*)
      note "BLOCKED  $f  — looks like a private key"; fail=1 ;;
    *kubeconfig*|*/credentials|.aws/*|.config/gcloud/*|.gcloud/*)
      note "BLOCKED  $f  — cluster or cloud credentials"; fail=1 ;;
    application_default_credentials.json*|*/application_default_credentials.json*)
      note "BLOCKED  $f  — gcloud ADC holds a long-lived OAuth refresh token"; fail=1 ;;
    backend.hcl)
      note "BLOCKED  $f  — names the state bucket, which embeds the project id"; fail=1 ;;
  esac
done

# --------------------------------------------------------------------------
# 2. Credential-shaped content in the staged diff
# --------------------------------------------------------------------------
# Only added lines are examined, and any line carrying the allowlist marker is
# skipped.
added=$(git diff --cached --unified=0 --diff-filter=ACMR \
        | grep '^+' | grep -v '^+++' | grep -v 'pragma: allowlist secret' || true)

# Case-insensitive: POSIX ERE has no inline (?i) flag.
scan() {
  pattern=$1
  message=$2
  if printf '%s\n' "$added" | grep -Eiq "$pattern"; then
    note "BLOCKED  $message"
    printf '%s\n' "$added" | grep -Ei "$pattern" | head -3 | sed 's/^/         /' >&2
    fail=1
  fi
}

# Each pattern carries the allowlist marker so that this file does not trip its
# own scan when it is itself staged.

# --- credentials -----------------------------------------------------------
# A service account key JSON is the highest-value thing that can leak from a
# GCP project: it is a long-lived credential with no expiry.
scan '"type"[[:space:]]*:[[:space:]]*"service_account"' 'service account key JSON'              # pragma: allowlist secret
scan '"private_key_id"'                             'service account key JSON'                  # pragma: allowlist secret
scan 'BEGIN [A-Z ]*PRIVATE KEY'                     'private key block'                         # pragma: allowlist secret
scan 'AIza[0-9A-Za-z_-]{35}'                        'Google API key'                            # pragma: allowlist secret
scan 'ya29\.[0-9A-Za-z_-]{20,}'                     'Google OAuth access token'                 # pragma: allowlist secret
scan '[0-9]+-[0-9a-z]{32}\.apps\.googleusercontent\.com' 'Google OAuth client id'               # pragma: allowlist secret
scan 'xox[baprs]-[0-9A-Za-z-]{10,}'                 'Slack token'                               # pragma: allowlist secret
scan 'gh[pousr]_[0-9A-Za-z]{20,}'                   'GitHub token'                              # pragma: allowlist secret

# Kept from the AWS era. It costs nothing, and gitleaks ignores a bare access
# key id, so dropping it would lose real coverage rather than dead weight.
scan '(AKIA|ASIA)[0-9A-Z]{16}'                      'AWS access key id'                         # pragma: allowlist secret

# --- account identifiers ---------------------------------------------------
# Not secrets, but this repository is public and they name the project to
# anyone reading it. Everything below has a derived alternative:
# data.google_project for the number, TF_VAR_project_id for the id, and the
# auth step's output in CI.
#
# Each pattern requires a literal value where an expression would normally be.
# `[a-z]` immediately after the slash rejects Terraform's ${var...},
# shell's ${PROJECT_ID}, Helm's {{ ... }} and a README's <project-id>, all of
# which start with a non-letter — so the legitimate constructions do not trip
# this and only a hardcoded value does.
scan 'projects/[0-9]{10,14}[/"[:space:]]'           'hardcoded project number'                  # pragma: allowlist secret
scan '[a-z0-9-]+-docker\.pkg\.dev/[a-z][a-z0-9-]{4,28}[a-z0-9]/' 'hardcoded project id in a registry URI' # pragma: allowlist secret
scan '[a-z0-9-]+@[a-z][a-z0-9-]{4,28}\.iam\.gserviceaccount\.com' 'hardcoded service account email'       # pragma: allowlist secret
scan '[0-9A-F]{6}-[0-9A-F]{6}-[0-9A-F]{6}'          'billing account id'                        # pragma: allowlist secret

# --------------------------------------------------------------------------
# 3. gitleaks — required, not a second opinion
# --------------------------------------------------------------------------
# The checks above are a deliberately small pattern set. Treating gitleaks as
# optional means a machine that happens to lack it commits with much weaker
# scanning and says nothing about it, which is the failure mode worth avoiding:
# a gate that quietly stops gating looks identical to a gate that passed.
#
# `protect --staged` still works but was deprecated in gitleaks 8.19.0; the
# current CLI is git / dir / stdin.
if ! command -v gitleaks >/dev/null 2>&1; then
  note 'BLOCKED  gitleaks is not on PATH'
  printf '         install:  winget install gitleaks   (or: brew install gitleaks)\n' >&2
  printf '         the commit is blocked rather than scanned with patterns alone\n' >&2
  fail=1
elif ! git diff --cached | gitleaks stdin --redact --no-banner >/dev/null 2>&1; then
  note 'BLOCKED  gitleaks flagged the staged changes'
  git diff --cached | gitleaks stdin --redact --no-banner 2>&1 | head -20 >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  printf '%sCommit aborted. Nothing was committed.%s\n' "$YELLOW" "$RESET" >&2
  printf 'If this is genuinely a false positive, add "pragma: allowlist secret" to the line.\n' >&2
  exit 1
fi

exit 0
