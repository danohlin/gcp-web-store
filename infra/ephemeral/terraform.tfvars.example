# Copy to terraform.tfvars. Real .tfvars files are gitignored and blocked by the
# pre-commit hook.
#
# project_id is the only value with no default, precisely so it cannot be
# committed by accident. There is no project number, billing id, key or password
# anywhere in here: the number is read at plan time from the google_project data
# source, and every secret is generated by Terraform straight into Secret
# Manager.
#
# Alternatively, skip this file entirely and export TF_VAR_project_id.

project_id  = "REPLACE_WITH_PROJECT_ID"
project     = "web-store"
environment = "dev"
region      = "us-central1"

# --- cost dials -------------------------------------------------------------
# Off saves ~$0.044/hr. Nothing here needs public internet egress: Artifact
# Registry, Secret Manager and Cloud SQL are all reachable over Private Google
# Access, which the subnet enables.
enable_cloud_nat = false

# Spot Pods are 60-91% cheaper and fine for an environment rebuilt daily.
# Applied through the Helm values, since Autopilot has no node pools.
use_spot_pods = true

# --- database ---------------------------------------------------------------
db_tier = "db-f1-micro"
# Keep in step with the postgres image in ci.yml and docker-compose.yml.
db_database_version = "POSTGRES_17"

# --- guard rail -------------------------------------------------------------
# Set BOTH to get alerted at 80% actual and 100% forecast spend. Leave either
# empty to skip creating the budget. The billing account id is an account
# identifier — keep it here, in the gitignored file, never in a tracked one.
budget_notification_email = ""
# billing_account_id      = "REPLACE_WITH_BILLING_ACCOUNT_ID"
budget_limit_usd = 50

# --- optional ---------------------------------------------------------------
# Narrow this if your IP is stable. It stays open by default because the API
# still requires IAM auth, and a fixed CIDR blocks GitHub Actions runners.
# cluster_authorized_cidrs = ["203.0.113.4/32"]

# GKE release channel: RAPID, REGULAR or STABLE.
# release_channel = "REGULAR"
